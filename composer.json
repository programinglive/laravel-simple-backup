{
    "name": "programinglive/laravel-simple-backup",
    "description": "A simple Laravel package for backing up MySQL and PostgreSQL databases",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mahatma Mahardhika",
            "email": "mahatma.mahardhika@programinglive.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/config": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0",
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "ProgrammingLive\\LaravelSimpleBackup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ProgrammingLive\\LaravelSimpleBackup\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ProgrammingLive\\LaravelSimpleBackup\\LaravelSimpleBackupServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
